# Copy to .env.local and fill in. Next.js only exposes NEXT_PUBLIC_* variables to the browser.

# Root Over backend (rootover-backend-v2). Production: https://api.your-domain.com/api
# Demo features (demo logins, coupon hints) follow the API's DEMO_MODE; nothing to set here.
NEXT_PUBLIC_API_URL=http://localhost:5000/api
